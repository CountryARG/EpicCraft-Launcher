<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#11151e">
    <!-- Engine adapters remain attached for authentication and task lifecycle, never visible. -->
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="vertical" android:visibility="gone"
        android:importantForAccessibility="noHideDescendants">
        <com.kdt.mcgui.mcAccountSpinner android:id="@+id/account_spinner"
            android:layout_width="1dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/setting_button"
            android:layout_width="1dp" android:layout_height="1dp" />
        <com.kdt.mcgui.ProgressLayout android:id="@+id/progress_layout"
            android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/container_fragment"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
